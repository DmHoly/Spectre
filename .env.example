# Copier en .env (à la racine du projet, ignoré par git) et renseigner.
# Compte de lecture PRISM, commun à tous les profils de connexion :
PRISM_USER=
PRISM_PASSWORD=
# Compte propre à un profil (prioritaire), ex. le profil « carac » :
# PRISM_CARAC_USER=
# PRISM_CARAC_PASSWORD=
# SMTP (optionnel) :
# SPECTRE_SMTP_USER=
# SPECTRE_SMTP_PASSWORD=
